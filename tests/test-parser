-- Test 20: Free Mobile France (208/15), captured on an RM520N-GL
--
-- The one that matters most: an n28 carrier. n28 is FDD low band, and the
-- band table had it wrong before this branch -- 145800-154600, which is
-- neither n28's downlink nor its uplink. ARFCN 156510 fell outside it and
-- inside the range then filed under n20, so this exact carrier displayed as
-- n20. A real reading that the old table got wrong, not a constructed one.
--
-- It is also the first FDD NR sample here (KT's n78 is TDD) and the first
-- with 15 kHz subcarrier spacing, which is what low band uses.
print("Test 20: Free Mobile France capture (208/15, n28 FDD)")

local free_serving = parser.parse_serving_cell(
    '+QENG: "servingcell","NOCONN"\n' ..
    '+QENG: "LTE","FDD",208,15,6773F52,424,1675,3,4,4,579,-89,-9,-61,12,10,150,-\n' ..
    '+QENG: "NR5G-NSA",208,15,424,-84,7,-11,156510,28,1,0\n\nOK')

test("Free LTE band 3", free_serving.lte and free_serving.lte.band == 3)
test("Free LTE earfcn 1675", free_serving.lte and free_serving.lte.arfcn == 1675)
test("Free LTE pci 424", free_serving.lte and free_serving.lte.pci == 424)
test("Free LTE tac 579", free_serving.lte and free_serving.lte.tac == "579")
test("Free LTE rsrp -89", free_serving.lte and free_serving.lte.rsrp == -89)
test("Free LTE sinr 12", free_serving.lte and free_serving.lte.sinr == 12)
-- Seven-digit cell ID, in contrast to KT's six: 0x6773F52 >> 8 = 0x6773F
test("Free seven-digit cell id yields an eNodeB",
    utils.extract_enodeb(free_serving.lte.cell_id) == 423743)

test("Free NR5G band 28", free_serving.nr5g and free_serving.nr5g.band == 28)
test("Free NR5G arfcn 156510", free_serving.nr5g and free_serving.nr5g.arfcn == 156510)
test("Free NR5G rsrp -84", free_serving.nr5g and free_serving.nr5g.rsrp == -84)
test("Free NR5G sinr 7", free_serving.nr5g and free_serving.nr5g.sinr == 7)
test("Free NR5G rsrq -11", free_serving.nr5g and free_serving.nr5g.rsrq == -11)
-- scs 0 is 15 kHz. KT's n78 reports scs 1, 30 kHz. Low band FDD and mid band
-- TDD differ here, so a fixture with only one of them cannot catch a swap.
test("Free NR5G scs 0 (15 kHz)", free_serving.nr5g and free_serving.nr5g.scs == 0)

local free_ca = parser.parse_qcainfo(
    '+QCAINFO: "PCC",1675,75,"LTE BAND 3",1,424,-89,-9,-60,5\n' ..
    '+QCAINFO: "SCC",156510,1,"NR5G BAND 28",424\n\nOK')

test("Free PCC band 3", free_ca.pcc and free_ca.pcc.band == 3)
test("Free PCC home network state 1", free_ca.pcc and free_ca.pcc.state == 1)
test("Free has one secondary carrier", #free_ca.scc == 1)
test("Free SCC is the NR carrier", free_ca.scc[1].rat == "5g")
test("Free SCC band 28", free_ca.scc[1].band == 28)
test("Free SCC arfcn 156510", free_ca.scc[1].arfcn == 156510)

local free_status = { serving = free_serving, ca = free_ca }
utils.add_frequency_info(free_status)
utils.backfill_from_serving(free_status)

-- Bandwidth from two encodings again: QENG index 4 and QCAINFO 75 RB.
test("Free LTE bandwidth agrees across QENG index and QCAINFO RB count",
    free_serving.lte.bandwidth_dl_mhz == 15 and free_ca.pcc.bandwidth_mhz == 15)
test("Free NR bandwidth index 1 is 10 MHz",
    free_serving.nr5g.bandwidth_mhz == 10)
test("Free LTE earfcn 1675 is 1852.5 MHz",
    math.abs(free_serving.lte.frequency_mhz - 1852.5) < 0.001)
-- 156510 x 5 kHz = 782.55 MHz, inside n28's downlink of 758-803 MHz
test("Free NR arfcn 156510 is 782.55 MHz",
    math.abs(free_serving.nr5g.frequency_mhz - 782.55) < 0.001)

local free_nb = parser.parse_neighbours(
    '+QENG: "neighbourcell intra","LTE",1675,386,-15,-95,-67,-,-,-,-,-,-\n' ..
    '+QENG: "neighbourcell intra","LTE",1675,424,-9,-89,-60,-,-,-,-,-,-\n' ..
    '+QENG: "neighbourcell intra","LTE",1675,423,-14,-91,-67,-,-,-,-,-,-\n\nOK')

test("Free three neighbours parsed", #free_nb == 3)
-- All intra here, where KT's capture mixes intra and inter. The two shapes
-- differ by a trailing field, so a fixture wants both.
local all_intra = true
for _, n in ipairs(free_nb) do
    if n.scope ~= "intra" then all_intra = false end
end
test("Free neighbours are all intra-frequency", all_intra)
test("Free neighbour pci 386 rsrp -95",
    free_nb[1].pci == 386 and free_nb[1].rsrp == -95)

-- First capture with a populated SPN (third field). TIM and KT both send "",
-- so nothing until now proved the operator name is read from field 1 rather
-- than happening to be whichever field was non-empty.
local free_op = parser.parse_qspn('+QSPN: "Free","Free","Free",0,"20815"\n\nOK')
test("Free operator name", free_op and free_op.operator == "Free")
test("Free mcc/mnc 20815", free_op and free_op.mcc_mnc == "20815")
print("")

-- Test 21: KT again, a second visit with four carriers and a one-digit TAC
--
-- Same operator and bands as Test 19, so it is deliberately not a second full
-- fixture -- that would restate three dozen assertions for no signal. Only
-- what this capture reaches that the first one does not.
print("Test 21: KT four-carrier capture, single-digit TAC")

local kt2_serving = parser.parse_serving_cell(
    '+QENG: "servingcell","NOCONN"\n' ..
    '+QENG: "LTE","FDD",450,08,165F0C,264,1550,3,5,5,E,-73,-12,-41,11,2,-50,-\n' ..
    '+QENG: "NR5G-NSA",450,08,740,-74,6,-11,636672,78,12,1\n\nOK')

-- TAC is a hex string and arrives unpadded. Every other fixture has three
-- characters; this one has one, which a parser treating it as fixed-width
-- would mangle and a parser coercing it to a number would turn into nil.
test("single-digit TAC survives as a string", kt2_serving.lte.tac == "E")
test("a one-character TAC does not disturb the fields after it",
    kt2_serving.lte.rsrp == -73 and kt2_serving.lte.rsrq == -12
        and kt2_serving.lte.sinr == 11)
test("KT2 cell id 165F0C yields eNodeB 5727",
    utils.extract_enodeb(kt2_serving.lte.cell_id) == 5727)
test("KT2 NR pci 740", kt2_serving.nr5g.pci == 740)

-- Four carriers: two 13-field LTE SCCs in one response, where Test 19 has
-- one. Intra-band non-contiguous on B3 (1550 and 1694) plus B8 and n78.
local kt2_ca = parser.parse_qcainfo(
    '+QCAINFO: "PCC",1550,100,"LTE BAND 3",5,264,-78,-15,-41,2\n' ..
    '+QCAINFO: "SCC",1694,50,"LTE BAND 3",1,264,-85,-15,-60,0,0,-,-\n' ..
    '+QCAINFO: "SCC",3743,50,"LTE BAND 8",1,264,-72,-20,-44,0,0,-,-\n' ..
    '+QCAINFO: "SCC",636672,12,"NR5G BAND 78",740\n\nOK')

test("three secondary carriers parsed", #kt2_ca.scc == 3)
test("KT2 SCC order is preserved",
    kt2_ca.scc[1].arfcn == 1694 and kt2_ca.scc[2].arfcn == 3743
        and kt2_ca.scc[3].arfcn == 636672)
test("both LTE SCCs are on B3 and B8",
    kt2_ca.scc[1].band == 3 and kt2_ca.scc[2].band == 8)
test("intra-band CA on B3 keeps two distinct carriers",
    kt2_ca.pcc.arfcn == 1550 and kt2_ca.scc[1].arfcn == 1694
        and kt2_ca.pcc.band == kt2_ca.scc[1].band)
test("the NR carrier is last and still recognised as 5g",
    kt2_ca.scc[3].rat == "5g" and kt2_ca.scc[3].band == 78)
-- Both LTE SCCs report an unconfigured uplink, so the 13-field tail parses
-- the same way twice in one response.
test("both LTE SCCs have no uplink configured",
    kt2_ca.scc[1].ul_configured == 0 and kt2_ca.scc[2].ul_configured == 0)
print("")

-- ---------------------------------------------------------------------------
-- Test 22: WCDMA (3G) -- DERIVED FROM THE MANUAL, NOT A LIVE CAPTURE
-- ---------------------------------------------------------------------------
--
-- Every other fixture in this file is real output from a real operator, and
-- each one turned up something the manual did not say. This one is not: the
-- field order comes from doc/quectel-rm520n-excerpt.pdf, "AT+QENG Query
-- Primary Serving Cell and Neighbour Cell Information", In WCDMA mode:
--
--   +QENG: "servingcell",<state>,"WCDMA",<MCC>,<MNC>,<LAC>,<cellID>,<uarfcn>,
--          <PSC>,<RAC>,<RSCP>,<ecio>,<phych>,<SF>,<slot>,<speech_code>,<comMod>
--
-- and the values below were chosen to exercise it, not observed. What this
-- test therefore proves is that the parser matches the manual -- worth having,
-- since before it a 3G attach parsed to nothing at all and every consumer
-- reported a working modem as attached to nothing. It does not prove the
-- manual is right about this module. Replace it with a real capture when one
-- turns up, the way Tests 19-21 were built, and expect surprises: a
-- one-character TAC, a PCI of 0 and a six-digit cell ID all arrived that way.
print("Test 22: WCDMA serving cell (doc-derived, not a live capture)")
local w = parser.parse_serving_cell(
    '+QENG: "servingcell","NOCONN","WCDMA",222,10,00C1,D2620E,10713,120,5,' ..
    '-75,-9,0,3,0,0,1\n\nOK')

test("state parsed", w.state == "NOCONN")
test("wcdma cell present", w.wcdma ~= nil)
test("no LTE cell invented", w.lte == nil)
test("no NR cell invented", w.nr5g == nil)
test("mode stays nil (NSA/SA is not a 3G concept)", w.mode == nil)
test("mcc/mnc", w.wcdma.mcc == 222 and w.wcdma.mnc == 10)
-- Hexadecimal, and kept as strings for the same reason TAC is: coercing them
-- to numbers loses the leading zero and everything after the first letter.
test("LAC keeps its leading zero", w.wcdma.lac == "00C1")
test("cell id kept as a string", w.wcdma.cell_id == "D2620E")
test("uarfcn, not arfcn", w.wcdma.uarfcn == 10713 and w.wcdma.arfcn == nil)
test("psc", w.wcdma.psc == 120)
test("rac", w.wcdma.rac == 5)
-- RSCP and Ec/Io are not RSRP and RSRQ, and must not be published as them:
-- the thresholds that colour those do not apply here.
test("rscp, not rsrp", w.wcdma.rscp == -75 and w.wcdma.rsrp == nil)
test("ecio, not rsrq", w.wcdma.ecio == -9 and w.wcdma.rsrq == nil)
-- The manual lists no SINR field for WCDMA at all. Anything aiming by SINR
-- has nothing to work with on 3G, and must not be handed a stand-in.
test("no SINR exists in 3G", w.wcdma.sinr == nil)
test("phych/SF/slot parsed", w.wcdma.phych == 0 and w.wcdma.sf == 3
    and w.wcdma.slot == 0)
test("comMod parsed", w.wcdma.commod == 1)

-- 0 must survive as the number 0, not as nil: 0 is truthy in Lua, so a nil
-- here is a genuine parse failure rather than a display quirk. Same argument
-- as the PCI-0 neighbour in Test 19.
test("a zero field is the number 0, not nil",
    w.wcdma.phych == 0 and w.wcdma.slot == 0 and w.wcdma.speech_code == 0)

local wtech = { serving = w }
utils.add_technology(wtech)
test("technology is WCDMA", wtech.serving.technology == "WCDMA")
print("")

print("Test 23: technology naming across every attach type")
local function tech_of(serving)
    local st = { serving = serving }
    utils.add_technology(st)
    return st.serving.technology
end
test("LTE only -> LTE", tech_of({ lte = {} }) == "LTE")
test("LTE + NR, mode NSA -> NSA",
    tech_of({ mode = "NSA", lte = {}, nr5g = {} }) == "NSA")
test("NR alone, mode SA -> SA", tech_of({ mode = "SA", nr5g = {} }) == "SA")
test("WCDMA -> WCDMA", tech_of({ wcdma = {} }) == "WCDMA")
-- The two cases the whole toolkit is careful about. Neither is a technology,
-- and neither may be reported as one.
test("a cell-less serving read has no technology", tech_of({}) == nil)
local none = {}
utils.add_technology(none)
test("a failed serving read has no technology",
    none.serving == nil)
print("")

-- WCDMA neighbours are reported while camped on LTE too, so this line reaches
-- a modem that never leaves 4G. Parsed as an LTE neighbour -- which is what
-- used to happen -- <cell_resel_priority> becomes pci and the reselection
-- thresholds become rsrq and rsrp: small, plausible, and strong enough to sort
-- to the top of the five neighbours 5g-monitor shows.
print("Test 24: a WCDMA neighbour is not an LTE neighbour")
local mixed = parser.parse_neighbours(
    '+QENG: "neighbourcell intra","LTE",275,280,-14,-99,-67,-,-,-,-,-,-\n' ..
    '+QENG: "neighbourcell","WCDMA",10713,4,-8,-16,120,-75,-9,42\n\nOK')

test("both neighbours are kept", #mixed == 2)
test("the LTE neighbour still parses", mixed[1].rat == "lte"
    and mixed[1].pci == 280 and mixed[1].rsrp == -99)
test("the WCDMA neighbour is labelled wcdma", mixed[2].rat == "wcdma")
test("its uarfcn is recorded", mixed[2].uarfcn == 10713)
-- The manual gives two same-length WCDMA neighbour layouts that differ in
-- where PSC and RSCP sit, and nothing in the line says which is in use.
-- Recording nothing beats recording a reselection threshold as a signal.
test("no pci is guessed", mixed[2].pci == nil)
test("no rsrp is guessed", mixed[2].rsrp == nil)
test("no rsrq is guessed", mixed[2].rsrq == nil)
test("it is not mistaken for an LTE arfcn", mixed[2].arfcn == nil)
print("")

print("=== Results ===")
print(string.format("Passed: %d, Failed: %d", passed, failed))

if failed > 0 then
    os.exit(1)
end
