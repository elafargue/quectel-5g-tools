-- LTE: <DL_bandwidth> is an index in QENG, a resource-block count in QCAINFO
local LTE_BW_IDX = { [0] = 1.4, [1] = 3, [2] = 5, [3] = 10, [4] = 15, [5] = 20 }
local LTE_BW_RB = { [6] = 1.4, [15] = 3, [25] = 5, [50] = 10, [75] = 15, [100] = 20 }
local lte_bw_ok = true
for idx, mhz in pairs(LTE_BW_IDX) do
    if frequency.lte_bandwidth_mhz(idx, false) ~= mhz then lte_bw_ok = false end
end
for rb, mhz in pairs(LTE_BW_RB) do
    if frequency.lte_bandwidth_mhz(rb, true) ~= mhz then lte_bw_ok = false end
end
test("every LTE bandwidth index and RB count maps correctly", lte_bw_ok)
test("bandwidth formats to whole MHz", frequency.format_bandwidth(20) == "20 MHz")
test("an unknown bandwidth formats as ?",
    frequency.format_bandwidth(nil) == "? MHz")

