-- Captured from a GL-X3000 with an RM520N-GL:
--   AT+QNWPREFCFG="nsa_nr5g_band"  and  AT+QNWPREFCFG="lte_band"
--
-- This is the module telling us every band it is capable of camping on, so
-- it is the real lower bound on what these tables must recognise -- a bound
-- set by the hardware rather than by our reading of the spec. n75 and n76
-- are in the list, and were absent from the table until this branch: an
-- L-band SDL carrier would have been labelled n50 or n51, the TDD bands
-- occupying exactly the same megahertz.
local RM520N_NR_BANDS = {
    1, 2, 3, 5, 7, 8, 12, 13, 14, 18, 20, 25, 26, 28, 29, 30, 38, 40, 41,
    48, 66, 70, 71, 75, 76, 77, 78, 79,
}
local RM520N_LTE_BANDS = {
    1, 2, 3, 4, 5, 7, 8, 12, 13, 14, 17, 18, 19, 20, 25, 26, 28, 29, 30, 32,
    34, 38, 39, 40, 41, 42, 43, 46, 48, 66, 71,
}

local unknown_nr = {}
for _, band in ipairs(RM520N_NR_BANDS) do
    -- nil means the band appears nowhere in the table; false only means this
    -- particular ARFCN is outside it, which is what we expect for 0.
    if frequency.nr_band_contains(0, band) == nil then
        unknown_nr[#unknown_nr + 1] = "n" .. band
    end
end
test("every NR band the RM520N-GL supports is in the table" ..
    (unknown_nr[1] and (": missing " .. table.concat(unknown_nr, ", ")) or ""),
    #unknown_nr == 0)

local lte_seen = {}
for earfcn = 0, 68935 do
    local _, band = frequency.earfcn_to_mhz(earfcn)
    if band then lte_seen[band] = true end
end
local unknown_lte = {}
for _, band in ipairs(RM520N_LTE_BANDS) do
    if not lte_seen[band] then unknown_lte[#unknown_lte + 1] = "B" .. band end
end
test("every LTE band the RM520N-GL supports is in the table" ..
    (unknown_lte[1] and (": missing " .. table.concat(unknown_lte, ", ")) or ""),
    #unknown_lte == 0)

