local lte_bad = {}
for earfcn = 0, 68935 do
    local freq, band = frequency.earfcn_to_mhz(earfcn)
    if band then
        local edges = LTE_DL[band]
        if not edges then
            lte_bad[#lte_bad + 1] = string.format("B%d not in Table 5.5-1", band)
        elseif freq < edges[1] - 0.001 or freq > edges[2] + 0.001 then
            lte_bad[#lte_bad + 1] = string.format(
                "earfcn %d -> %.1f MHz, outside B%d (%g-%g)",
                earfcn, freq, band, edges[1], edges[2])
        end
    end
end
test("every LTE channel lands inside its band" ..
    (lte_bad[1] and (": " .. lte_bad[1]) or ""), #lte_bad == 0)

-- Bands must not claim overlapping EARFCN ranges: the lookup returns the
-- first match, so an overlap would silently hide a band.
local seen = {}
local overlap = nil
for earfcn = 0, 68935 do
    local _, band = frequency.earfcn_to_mhz(earfcn)
    if band then
        if seen[band] and seen[band] ~= earfcn - 1 then
            overlap = overlap or string.format("B%d is not contiguous", band)
        end
        seen[band] = earfcn
    end
end
test("LTE EARFCN ranges are contiguous per band" ..
    (overlap and (": " .. overlap) or ""), overlap == nil)

