#!/usr/bin/env lua
-- Test script for EARFCN/NR-ARFCN to frequency conversion
--
-- The band tables are the kind of data that is easy to get wrong and
-- impossible to eyeball: an FDD band's uplink range looks exactly as
-- plausible as its downlink one. So rather than restate the tables (which
-- would only prove they equal themselves), this derives the expected ARFCN
-- ranges from the operating band edges in MHz -- 3GPP TS 38.104 Table 5.2-1
-- and TS 36.101 Table 5.5-1 -- and checks the tables against those.

-- Working tree first: without this the suite silently validates whatever
-- version of the package happens to be installed in /usr/lib/lua on the
-- machine running it, and local edits go untested.
package.path = "lua/?.lua;lua/?/init.lua;/usr/lib/lua/?.lua;/usr/lib/lua/?/init.lua;" .. package.path

local frequency = require("quectel.frequency")

local passed = 0
local failed = 0

local function test(name, condition)
    if condition then
        print(string.format("  [OK] %s", name))
        passed = passed + 1
    else
        print(string.format("  [FAIL] %s", name))
        failed = failed + 1
    end
end

