-- 3GPP TS 38.104 Table 5.2-2: NR operating bands in FR2.
local NR_FR2 = {
    [257] = {26500, 29500}, [258] = {24250, 27500}, [259] = {39500, 43500},
    [260] = {37000, 40000}, [261] = {27500, 28350},
}

print("=== Testing NR5G band coverage (TS 38.104 Table 5.2-1 / 5.2-2) ===")
print("")

-- Walk each band's downlink edges. Every channel inside them must resolve to
-- that band when the modem names it, and to a frequency inside the band's own
-- spectrum either way. A table holding an uplink range fails on the first
-- count; one holding a neighbouring band's range fails on the second.
local function check_band(band, low_mhz, high_mhz, fr2)
    -- FR2 bands span thousands of MHz but n261 is only 850 wide; sample a
    -- fixed number of points so every band gets real coverage.
    local step = fr2 and math.max((high_mhz - low_mhz) / 200, 1) or 1
    local ok_band, ok_freq = true, true
    local first_bad_band, first_bad_freq
    local checked = 0
    for mhz = low_mhz, high_mhz, step do
        local arfcn
        if fr2 then
            arfcn = math.floor((mhz * 1000 - 24250080) / 60 + 0.5) + 2016667
        elseif mhz < 3000 then
            arfcn = math.floor(mhz * 1000 / 5 + 0.5)
        else
            arfcn = math.floor((mhz * 1000 - 3000000) / 15 + 0.5) + 600000
        end

        local freq, got = frequency.nrarfcn_to_mhz(arfcn)
        -- The nearest raster point can sit just outside the band edges; the
        -- band does not own that channel, so it is not ours to check.
        if freq and freq >= low_mhz and freq <= high_mhz then
            checked = checked + 1
            -- The table's own range for this band must contain the channel.
            -- Asking nrarfcn_to_mhz with the band would prove nothing: a
            -- reported band is echoed back by design.
            if frequency.nr_band_contains(arfcn, band) ~= true then
                ok_band = false
                first_bad_band = first_bad_band or string.format(
                    "arfcn %d (%.1f MHz) is outside the table's n%d",
                    arfcn, freq, band)
            end
            if not got then
                ok_freq = false
                first_bad_freq = first_bad_freq or string.format(
                    "arfcn %d (%.1f MHz) resolves to no band", arfcn, freq)
            end
        end
    end
    test(string.format("n%d covers its whole downlink (%g-%g MHz)%s",
        band, low_mhz, high_mhz,
        first_bad_band and (": " .. first_bad_band) or ""),
        ok_band and checked > 0)
    test(string.format("n%d channels resolve to some band%s", band,
        first_bad_freq and (": " .. first_bad_freq) or ""), ok_freq)
end

for _, set in ipairs({{NR_FR1_DL, false}, {NR_FR2, true}}) do
    local bands = {}
    for band in pairs(set[1]) do bands[#bands + 1] = band end
    table.sort(bands)
    for _, band in ipairs(bands) do
        check_band(band, set[1][band][1], set[1][band][2], set[2])
    end
end

print("")
print("=== Testing NR5G uplink ranges are absent ===")
print("")

-- The bug this suite was written for: FDD uplink ranges standing in for the
-- downlink. An uplink channel must never resolve to its own band.
local NR_FR1_UL = {
    [1] = {1920, 1980},  [2] = {1850, 1910},  [3] = {1710, 1785},
    [5] = {824, 849},    [7] = {2500, 2570},  [8] = {880, 915},
    [12] = {699, 716},   [18] = {815, 830},   [25] = {1850, 1915},
    [26] = {814, 849},   [30] = {2305, 2315}, [65] = {1920, 2010},
    [85] = {698, 716},
}
local ul_bands = {}
for band in pairs(NR_FR1_UL) do ul_bands[#ul_bands + 1] = band end
table.sort(ul_bands)
for _, band in ipairs(ul_bands) do
    local lo, hi = NR_FR1_UL[band][1], NR_FR1_UL[band][2]
    local clean = true
    for mhz = lo, hi do
        local arfcn = math.ceil(mhz * 1000 / 5)
        -- Only where the uplink does not genuinely overlap some downlink:
        -- n65's uplink runs into n1's, and n26/n5 uplink into n20's.
        if not NR_FR1_DL[band] or mhz < NR_FR1_DL[band][1]
                or mhz > NR_FR1_DL[band][2] then
            if frequency.nr_band_contains(arfcn, band) then clean = false end
        end
    end
    test(string.format("n%d uplink (%g-%g MHz) is not treated as downlink",
        band, lo, hi), clean)
end

-- n83 is SUL: uplink only, and its range shadows the n12/n28/n85 downlinks.
test("SUL band n83 is not in the downlink table",
    frequency.nr_band_contains(145000, 83) == nil)

print("")
print("=== Testing modem-reported band wins over the lookup ===")
print("")

-- 2120 MHz is n1, n65 and n66 alike; the ARFCN cannot tell them apart.
local freq, band = frequency.nrarfcn_to_mhz(424000, 1)
test("arfcn 424000 + band 1 -> n1", band == 1)
test("arfcn 424000 -> 2120.0 MHz", math.abs(freq - 2120.0) < 0.001)
local _, b65 = frequency.nrarfcn_to_mhz(424000, 65)
test("arfcn 424000 + band 65 -> n65", b65 == 65)
local _, b66 = frequency.nrarfcn_to_mhz(424000, 66)
test("arfcn 424000 + band 66 -> n66", b66 == 66)
local _, guess = frequency.nrarfcn_to_mhz(424000)
test("arfcn 424000 with no band falls back to the table", guess ~= nil)

-- A reported band is authoritative even when this table disagrees: the
-- table is the thing more likely to be out of date. The disagreement stays
-- detectable rather than being silently resolved either way.
local _, reported, src = frequency.nrarfcn_to_mhz(648768, 20)
test("a reported band is used as given, not second-guessed", reported == 20)
test("a reported band is marked as reported", src == "reported")
test("the disagreement is still detectable",
    frequency.nr_band_contains(648768, 20) == false)

-- A band this table has never heard of means the table is behind, not that
-- the modem is wrong.
local _, unknown_band, usrc = frequency.nrarfcn_to_mhz(648768, 254)
test("an unknown reported band survives", unknown_band == 254)
test("an unknown reported band is still 'reported'", usrc == "reported")
test("an unknown band is reported as unknown by the predicate",
    frequency.nr_band_contains(648768, 254) == nil)

-- Inferred bands are flagged so they cannot be mistaken for a reading.
local _, inferred, isrc = frequency.nrarfcn_to_mhz(648768)
test("an ARFCN alone yields an inferred band", isrc == "inferred")
test("the inferred band for 648768 is n78", inferred == 78)
test("an inferred band is printed with a ?",
    frequency.format_frequency(648768, true) == "3731.5 MHz (n78?)")
test("a reported band is printed without a ?",
    frequency.format_frequency(648768, true, 78) == "3731.5 MHz (n78)")

-- The L-band pile-up the ? exists for: 1450 MHz is four bands at once.
local lband = math.floor(1450 * 1000 / 5)
test("1450 MHz is a valid n50 channel", frequency.nr_band_contains(lband, 50))
test("1450 MHz is a valid n75 channel", frequency.nr_band_contains(lband, 75))
test("1450 MHz is a valid n92 channel", frequency.nr_band_contains(lband, 92))
test("1450 MHz is a valid n94 channel", frequency.nr_band_contains(lband, 94))
test("1450 MHz alone is only ever a guess",
    select(3, frequency.nrarfcn_to_mhz(lband)) == "inferred")

