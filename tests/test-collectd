#!/usr/bin/env lua
-- Test script for the collectd exec output
--
-- The exec plugin trusts whatever it reads on stdout. There is no schema and
-- no rejection path we would see, so a malformed line is dropped in silence
-- and a fabricated value is graphed as signal. Both failures look identical
-- from the router: a metric that is simply not there, or one that is quietly
-- wrong. This drives bin/5g-collectd against a stubbed modem and reads the
-- lines it actually prints.

-- Working tree first: without this the suite silently validates whatever
-- version of the package happens to be installed in /usr/lib/lua on the
-- machine running it, and local edits go untested.
package.path = "lua/?.lua;lua/?/init.lua;/usr/lib/lua/?.lua;/usr/lib/lua/?/init.lua;" .. package.path

for _, mod in ipairs({"posix", "posix.unistd", "posix.fcntl", "posix.termio",
                      "posix.sys.stat", "posix.time"}) do
    if not package.loaded[mod] then
        package.preload[mod] = function() return {} end
    end
end
if not package.loaded["posix.signal"] then
    package.preload["posix.signal"] = function()
        return { signal = function() end, SIGTERM = 15, SIGINT = 2 }
    end
end

local quectel = require("quectel")
local modem_mod = require("quectel.modem")

local passed = 0
local failed = 0

local function test(name, condition)
    if condition then
        print(string.format("  [OK] %s", name))
        passed = passed + 1
    else
        print(string.format("  [FAIL] %s", name))
        failed = failed + 1
    end
end

-- KT Korea, four carriers: LTE B3 anchor with a B3 and a B8 secondary, plus
-- an n78 NR carrier.
local CANNED = {
    ['AT+QENG="servingcell"'] = '+QENG: "servingcell","NOCONN"\n' ..
        '+QENG: "LTE","FDD",450,08,165F0C,264,1550,3,5,5,E,-73,-12,-41,11,2,-50,-\n' ..
        '+QENG: "NR5G-NSA",450,08,740,-74,6,-11,636672,78,12,1\n\nOK',
    ["AT+QCAINFO"] = '+QCAINFO: "PCC",1550,100,"LTE BAND 3",5,264,-78,-15,-41,2\n' ..
        '+QCAINFO: "SCC",1694,50,"LTE BAND 3",1,264,-85,-15,-60,0,0,-,-\n' ..
        '+QCAINFO: "SCC",3743,50,"LTE BAND 8",1,264,-72,-20,-44,0,0,-,-\n' ..
        '+QCAINFO: "SCC",636672,12,"NR5G BAND 78",740\n\nOK',
}

-- Run bin/5g-collectd once against a stubbed transport, returning the lines
-- it printed and the status it exited with.
local function run(err_for_every_read)
    local real_create = quectel.create_modem
    quectel.create_modem = function()
        local self = setmetatable({}, modem_mod)
        self.send = function(_, cmd)
            if err_for_every_read then return nil, err_for_every_read end
            return CANNED[cmd] or "OK"
        end
        self.close = function() end
        return self
    end

    local lines = {}
    local real_print, real_exit, real_arg = print, os.exit, arg
    local code
    _G.print = function(...)
        local parts = {}
        for i = 1, select("#", ...) do
            parts[#parts + 1] = tostring((select(i, ...)))
        end
        lines[#lines + 1] = table.concat(parts, "\t")
    end
    -- The script exits after one sample under --once; turn that into
    -- something catchable rather than killing the suite.
    os.exit = function(c) code = c; error({ exit = true }, 0) end
    _G.arg = { "--once" }

    local chunk = loadfile("bin/5g-collectd")
    local ok, e = pcall(chunk)

    _G.print, os.exit, _G.arg = real_print, real_exit, real_arg
    quectel.create_modem = real_create
    if not ok and type(e) ~= "table" then error(e) end
    return lines, code
end

local function find(lines, pattern)
    for _, l in ipairs(lines) do
        local v = l:match(pattern)
        if v then return v end
    end
    return nil
end

print("=== Testing collectd output from a healthy modem ===")
print("")

local lines, code = run(nil)
test("exits successfully", code == 0)
test("emits metrics", #lines > 0)

local well_formed = true
for _, l in ipairs(lines) do
    -- PUTVAL <host>/<plugin>-<instance>/<type>-<instance> interval=N N:<value>
    if not l:match("^PUTVAL %S+/%S+/%S+ interval=%d+ N:%-?%d+%.?%d*$") then
        well_formed = false
    end
end
test("every line matches the PUTVAL grammar", well_formed)

test("LTE RSRP is reported",
    find(lines, "quectel_lte/gauge%-rsrp .* N:(-?%d+)") == "-73")
-- RSRQ is always negative. collectd's stock signal_quality type is 0:U, so
-- this value would be rejected as out of range under it; gauge is U:U.
test("negative RSRQ survives",
    find(lines, "quectel_lte/gauge%-rsrq .* N:(-?%d+)") == "-12")
test("NR RSRP is reported",
    find(lines, "quectel_nr5g/gauge%-rsrp .* N:(-?%d+)") == "-74")
test("NR band is reported",
    find(lines, "quectel_nr5g/gauge%-band .* N:(%d+)") == "78")
test("NR attachment is reported as 1",
    find(lines, "quectel_radio/gauge%-nr_attached .* N:(%d+)") == "1")
test("all four carriers are counted",
    find(lines, "quectel_radio/gauge%-carriers .* N:(%d+)") == "4")

-- Carriers are addressed by slot, never by band: a band in the path would
-- mint a new RRD file at every handover.
test("carriers are addressed by slot, not band",
    find(lines, "(quectel_scc0)/") == "quectel_scc0"
        and find(lines, "(quectel_scc1)/") == "quectel_scc1")
local band_in_path = false
for _, l in ipairs(lines) do
    if l:match("quectel_[ns]%w*_?b%d") or l:match("quectel_n78") then
        band_in_path = true
    end
end
test("no band number appears in a metric path", not band_in_path)
test("the NR secondary carrier lands in a slot",
    find(lines, "quectel_scc2/gauge%-band .* N:(%d+)") == "78")

-- The interval reaches collectd, or it assumes its own default and marks
-- values stale at the wrong time.
local all_interval = true
for _, l in ipairs(lines) do
    if not l:match("interval=%d+") then all_interval = false end
end
test("every line carries an interval", all_interval)

print("")
print("=== Testing collectd output when the modem does not answer ===")
print("")

-- The point of the whole exercise. collectd draws a gap for a value it never
-- receives, which is the truth. Anything emitted here -- a zero, a repeat of
-- the last sample -- draws as signal instead, and on a graph used to judge an
-- antenna that is worse than no graph.
local dead_lines, dead_code = run("timeout after 2s")
test("a failed read emits nothing at all", #dead_lines == 0)
test("a failed read exits non-zero", dead_code == 1)

print("")
print("=== Testing that absent fields are skipped, not zeroed ===")
print("")

-- LTE secondary carriers carry no SINR: QCAINFO reports RSSNR there, and the
-- backfill only fills SINR for a carrier matching the serving cell. That
-- absence must stay absent rather than arriving as a zero, which would read
-- as a terrible but real signal-to-noise ratio.
local scc0_sinr = find(lines, "quectel_scc0/gauge%-(sinr)")
test("an LTE secondary carrier reports no SINR rather than zero",
    scc0_sinr == nil)
test("the same carrier does report its RSRP",
    find(lines, "quectel_scc0/gauge%-rsrp .* N:(-?%d+)") == "-85")

print("")
print(string.format("=== %d passed, %d failed ===", passed, failed))
os.exit(failed > 0 and 1 or 0)
